# Supabase — create a free project at https://supabase.com, then copy the
# values from Project Settings → API. The anon key is safe to expose to the
# browser (protected by Row Level Security); NEVER put the service_role key
# in this file or any frontend code.
#
# Copy this file to `.env.local` and fill in real values. Until both values
# exist, the app runs in demo mode (local mock auth) so the UI stays testable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
